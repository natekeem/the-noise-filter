---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { categories } from "@/data/categories";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
const currentPath = stripLocale(pathWithoutTrailingSlash, locale);
const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(`${path}/`);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-surface text-accent fixed -top-full left-4 z-50 border px-3 py-2 transition-all focus:top-4"
>
  Skip to content
</a>

<header
  class="border-border bg-background/95 sticky top-0 z-40 border-b backdrop-blur"
>
  <div class="app-layout">
    <div class="flex min-h-20 items-center justify-between gap-4">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="group flex min-w-0 flex-col py-3"
        aria-label={`${site.title} home`}
      >
        <span
          class="font-display text-2xl leading-none font-bold tracking-normal sm:text-3xl"
        >
          {site.title}
        </span>
        <span class="text-muted-foreground mt-1 hidden text-sm sm:block">
          What changed, what matters, and what to ignore.
        </span>
      </a>

      <nav class="hidden items-center gap-5 lg:flex" aria-label="Primary">
        {
          categories.map(category => (
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class:list={[
                "text-muted-foreground hover:text-accent text-sm font-semibold",
                { "active-nav": isActive(`/categories/${category.slug}`) },
              ]}
            >
              {category.name}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          class="focus-outline border-border bg-surface hover:border-accent inline-flex size-11 items-center justify-center border"
          aria-label="Search The Noise Filter"
        >
          <IconSearch class="size-5" />
        </a>
        <button
          id="menu-btn"
          class="focus-outline border-border bg-surface hover:border-accent inline-flex size-11 items-center justify-center border lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <IconX id="close-icon" class="hidden size-5" />
          <IconMenuDeep id="menu-icon" class="size-5" />
        </button>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="border-border hidden border-t py-4 lg:hidden"
      aria-label="Mobile primary"
    >
      <div class="grid gap-2">
        {
          categories.map(category => (
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category.slug}`)}
              class:list={[
                "bg-surface border-border hover:border-accent block border px-4 py-3 text-sm font-semibold",
                { "active-nav": isActive(`/categories/${category.slug}`) },
              ]}
            >
              {category.name}
            </a>
          ))
        }
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="bg-surface border-border hover:border-accent block border px-4 py-3 text-sm font-semibold"
        >
          Latest stories
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#mobile-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open menu" : "Close menu");
      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
