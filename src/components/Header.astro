---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconX from "@/assets/icons/IconX.svg";
import BrandMark from "@/components/BrandMark.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
const currentPath = stripLocale(pathWithoutTrailingSlash, locale);
const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(`${path}/`);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-surface text-accent fixed -top-full left-4 z-50 rounded border px-3 py-2 text-sm font-semibold transition-all focus:top-4"
>
  Skip to content
</a>

<header
  class="border-border bg-background/95 sticky top-0 z-40 border-b backdrop-blur-md"
>
  <div class="app-layout">
    <div class="flex h-16 items-center justify-between gap-6">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="group text-foreground flex items-center gap-3 py-2"
        aria-label={`${site.title} home`}
      >
        <BrandMark
          class="text-accent h-5 w-auto transition-transform duration-200 group-hover:scale-105"
        />
        <span
          class="font-display text-foreground text-xl font-bold tracking-tight sm:text-2xl"
        >
          {site.title}
        </span>
      </a>

      <div class="flex items-center gap-6">
        <nav class="hidden items-center gap-6 sm:flex" aria-label="Primary">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "text-muted-foreground hover:text-foreground text-sm font-medium transition-colors",
              { "active-nav": isActive("/posts") },
            ]}
          >
            Latest
          </a>
          <a
            href={getRelativeLocaleUrl(locale, "categories")}
            class:list={[
              "text-muted-foreground hover:text-foreground text-sm font-medium transition-colors",
              { "active-nav": isActive("/categories") },
            ]}
          >
            Topics
          </a>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "text-muted-foreground hover:text-foreground text-sm font-medium transition-colors",
              { "active-nav": isActive("/about") },
            ]}
          >
            About
          </a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="focus-outline text-muted-foreground hover:bg-muted hover:text-foreground inline-flex size-9 items-center justify-center rounded-md transition-colors"
            aria-label="Search"
          >
            <IconSearch class="size-4" />
          </a>
          <button
            id="menu-btn"
            class="focus-outline text-muted-foreground hover:bg-muted hover:text-foreground inline-flex size-9 items-center justify-center rounded-md transition-colors sm:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <IconX id="close-icon" class="hidden size-5" />
            <IconMenuDeep id="menu-icon" class="size-5" />
          </button>
        </div>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="border-border hidden border-t py-4 sm:hidden"
      aria-label="Mobile primary"
    >
      <div class="grid gap-2">
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class:list={[
            "text-muted-foreground hover:bg-muted hover:text-foreground rounded-md px-3 py-2 text-base font-medium",
            { "bg-muted text-foreground font-semibold": isActive("/posts") },
          ]}
        >
          Latest
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "categories")}
          class:list={[
            "text-muted-foreground hover:bg-muted hover:text-foreground rounded-md px-3 py-2 text-base font-medium",
            {
              "bg-muted text-foreground font-semibold": isActive("/categories"),
            },
          ]}
        >
          Topics
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class:list={[
            "text-muted-foreground hover:bg-muted hover:text-foreground rounded-md px-3 py-2 text-base font-medium",
            { "bg-muted text-foreground font-semibold": isActive("/about") },
          ]}
        >
          About
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#mobile-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open menu" : "Close menu");
      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
