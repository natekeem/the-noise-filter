---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getCategory } from "@/data/categories";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  compact?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  compact = false,
  id,
  data,
  filePath,
} = Astro.props;
const { title, description, category, contentType, ...props } = data;
const locale = Astro.currentLocale ?? config.site.lang;
const categoryInfo = getCategory(category);
---

<li
  class:list={[
    "signal-panel group min-w-0 list-none",
    compact ? "p-4" : "p-5 sm:p-6",
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    {
      categoryInfo && (
        <a
          href={getRelativeLocaleUrl(locale, `categories/${categoryInfo.slug}`)}
          class="editorial-label hover:text-accent"
        >
          {categoryInfo.name}
        </a>
      )
    }
    <span class="text-muted-foreground text-xs" aria-hidden="true">/</span>
    <span class="editorial-label">{contentType}</span>
  </div>
  <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="mt-3 block">
    <Heading
      transition:name={toTransitionName(title)}
      class:list={[
        "font-display group-hover:text-accent leading-tight font-bold break-words",
        compact ? "text-xl" : "text-2xl sm:text-3xl",
      ]}
    >
      {title}
    </Heading>
  </a>
  <p class="text-muted-foreground mt-3 text-base leading-7">{description}</p>
  <div class="text-muted-foreground mt-4 text-sm">
    <Datetime {...props} />
  </div>
</li>
