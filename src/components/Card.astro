---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getCategory } from "@/data/categories";
import { getAssetPath } from "@/utils/withBase";
import { getReadingTime } from "@/utils/getReadingTime";
import { formatPostDate } from "@/utils/formatPostDate";
import config from "@/config";

type Props = {
  /** Heading level for the title */
  variant?: "h2" | "h3";
  /** row: list row with thumbnail on the right · tile: thumbnail on top */
  layout?: "row" | "tile";
  /** hide the description (used by dense lists) */
  hideDescription?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  layout = "row",
  hideDescription = false,
  id,
  data,
  filePath,
  body,
} = Astro.props;
const { title, description, category, ogImage, coverAlt } = data;
const locale = Astro.currentLocale ?? config.site.lang;
const categoryInfo = getCategory(category);
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const minutes = getReadingTime(body);
const date = formatPostDate(data);
---

{
  layout === "tile" ? (
    <li class="group min-w-0 list-none" data-category={category}>
      {ogImage && (
        <a
          href={postUrl}
          class="media-frame block aspect-[16/10]"
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src={getAssetPath(ogImage)}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </a>
      )}
      <div class="mt-4">
        {categoryInfo && (
          <a
            href={getRelativeLocaleUrl(
              locale,
              `categories/${categoryInfo.slug}`
            )}
            class="category-label"
          >
            {categoryInfo.name}
          </a>
        )}
        <a href={postUrl} class="mt-2 block">
          <Heading class="font-display text-foreground group-hover:text-accent text-xl leading-snug font-semibold break-words transition-colors">
            {title}
          </Heading>
        </a>
        <p class="post-meta mt-2">
          <time datetime={date.iso}>{date.label}</time>
          <span>{minutes} min read</span>
        </p>
      </div>
    </li>
  ) : (
    <li
      class="group border-border grid min-w-0 list-none grid-cols-[minmax(0,1fr)_6.5rem] gap-x-5 border-b py-7 first:pt-0 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_11rem] sm:gap-x-7"
      data-category={category}
    >
      <div class="min-w-0">
        {categoryInfo && (
          <a
            href={getRelativeLocaleUrl(
              locale,
              `categories/${categoryInfo.slug}`
            )}
            class="category-label"
          >
            {categoryInfo.name}
          </a>
        )}
        <a href={postUrl} class="mt-2 block">
          <Heading
            transition:name={toTransitionName(title)}
            class="font-display text-foreground group-hover:text-accent text-[1.3rem] leading-snug font-semibold break-words transition-colors sm:text-2xl sm:leading-[1.25]"
          >
            {title}
          </Heading>
        </a>
        {!hideDescription && (
          <p class="text-muted-foreground mt-2 line-clamp-3 text-[0.98rem] leading-relaxed sm:line-clamp-2 sm:text-base">
            {description}
          </p>
        )}
        <p class="post-meta mt-3">
          <time datetime={date.iso}>
            {date.isUpdated ? `Updated ${date.label}` : date.label}
          </time>
          <span>{minutes} min read</span>
        </p>
      </div>
      {ogImage ? (
        <a
          href={postUrl}
          class="media-frame mt-1 block aspect-square self-start sm:aspect-[4/3]"
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src={getAssetPath(ogImage)}
            alt={coverAlt ? "" : ""}
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
    </li>
  )
}
