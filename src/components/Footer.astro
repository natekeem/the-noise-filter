---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { categories } from "@/data/categories";
import BrandMark from "@/components/BrandMark.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={[
    "border-border bg-surface-tint/60 mt-20 border-t",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="app-layout py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
      <!-- Brand column -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <BrandMark class="text-accent h-4 w-auto" />
          <span class="font-display text-foreground text-xl font-bold">
            {config.site.title}
          </span>
        </div>
        <p class="text-muted-foreground max-w-sm text-sm leading-relaxed">
          {config.site.description}
        </p>
        <p class="text-muted-foreground text-xs">
          Hot stories, filtered for regular adults. Independent explainers,
          verified facts.
        </p>
      </div>

      <!-- Topics column -->
      <div>
        <p class="editorial-label text-muted-foreground mb-4">Topics</p>
        <ul class="space-y-2.5 text-sm">
          {
            categories.map(category => (
              <li>
                <a
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  href={getRelativeLocaleUrl(
                    locale,
                    `categories/${category.slug}`
                  )}
                >
                  {category.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Trust column -->
      <div>
        <p class="editorial-label text-muted-foreground mb-4">
          Editorial & Trust
        </p>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              class="text-muted-foreground hover:text-foreground transition-colors"
              href={getRelativeLocaleUrl(locale, "about")}
            >
              About & Methodology
            </a>
          </li>
          <li>
            <a
              class="text-muted-foreground hover:text-foreground transition-colors"
              href={getRelativeLocaleUrl(locale, "contact")}
            >
              Contact
            </a>
          </li>
          <li>
            <a
              class="text-muted-foreground hover:text-foreground transition-colors"
              href={getRelativeLocaleUrl(locale, "privacy")}
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              class="text-muted-foreground hover:text-foreground transition-colors"
              href={getRelativeLocaleUrl(locale, "disclosure")}
            >
              Editorial Disclosure
            </a>
          </li>
          <li>
            <a
              class="text-muted-foreground hover:text-foreground transition-colors"
              href={getRelativeLocaleUrl(locale, "rss.xml")}
            >
              RSS Feed
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom copyright -->
    <div
      class="border-border/80 text-muted-foreground mt-12 flex flex-col items-center justify-between gap-4 border-t pt-6 text-xs sm:flex-row"
    >
      <p>
        &copy; {currentYear}
        {config.site.title}. All rights reserved.
      </p>
      <p>No tracking cookies &bull; Independent editorial</p>
    </div>
  </div>
</footer>
