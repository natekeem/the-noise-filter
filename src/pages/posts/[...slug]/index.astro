---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Card from "@/components/Card.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getCategory } from "@/data/categories";
import { toTransitionName } from "@/utils/toTransitionName";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.DEV ? true : !data.draft
  );
  const eligiblePosts = posts
    .filter(post => import.meta.env.DEV || !post.data.draft)
    .sort(
      (a, b) =>
        new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
        new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
    );

  return eligiblePosts.map(post => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      relatedPosts: eligiblePosts
        .filter(
          item =>
            item.id !== post.id && item.data.category === post.data.category
        )
        .slice(0, 3),
    },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  relatedPosts: CollectionEntry<"posts">[];
};

const { post, relatedPosts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  category,
  contentType,
  quickTake = [],
  quickFilter,
  updateNote,
  draft,
} = post.data;

const categoryInfo = getCategory(category);
const { Content } = await render(post);

let ogImageUrl = initOgImage;

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(
      ogImageUrl.startsWith("http") ? ogImageUrl : getAssetPath(ogImageUrl),
      Astro.url.origin
    ).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content" class="app-layout py-8" data-pagefind-body>
    <article class="mx-auto max-w-[760px]" data-category={category}>
      <header class="border-border article-header-accent border-b pb-8">
        <div class="flex flex-wrap items-center gap-2">
          {
            categoryInfo && (
              <span class="editorial-label">{categoryInfo.name}</span>
            )
          }
          <span class="text-muted-foreground text-xs" aria-hidden="true">/</span
          >
          <span class="editorial-label">{contentType}</span>
          {
            draft && (
              <>
                <span class="text-muted-foreground text-xs" aria-hidden="true">
                  /
                </span>
                <span class="editorial-label">Draft Preview</span>
              </>
            )
          }
        </div>

        <h1
          style={{ viewTransitionName: toTransitionName(title) }}
          class="font-display mt-5 text-4xl leading-tight font-bold break-words sm:text-5xl"
        >
          {title}
        </h1>
        <p class="text-muted-foreground mt-5 text-xl leading-8">
          {description}
        </p>

        {
          ogImageUrl && (
            <img
              src={getAssetPath(ogImageUrl)}
              alt="A generic smartphone with abstract vertical entertainment clips arranged in a modern editorial composition."
              class="border-border mt-7 aspect-video w-full border object-cover"
              width="1680"
              height="945"
              loading="eager"
            />
          )
        }

        <div class="text-muted-foreground mt-5 text-sm">
          <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
        </div>
      </header>

      {
        quickFilter ? (
          <aside class="quick-filter my-8" aria-label="Quick Filter">
            <div class="quick-filter-title">
              <p class="editorial-label">Quick Filter</p>
              <span class="signal-rule" aria-hidden="true" />
            </div>
            <dl class="quick-filter-grid">
              <div>
                <dt>What changed</dt>
                <dd>{quickFilter.changed}</dd>
              </div>
              <div>
                <dt>What matters</dt>
                <dd>{quickFilter.matters}</dd>
              </div>
              <div>
                <dt>What to ignore for now</dt>
                <dd>{quickFilter.ignore}</dd>
              </div>
            </dl>
          </aside>
        ) : (
          quickTake.length > 0 && (
            <aside class="signal-panel my-8 p-5 sm:p-6" aria-label="Quick take">
              <p class="editorial-label">Quick Take</p>
              <ul class="mt-4 grid gap-3">
                {quickTake.map(item => (
                  <li class="flex gap-3 leading-7">
                    <span
                      class="bg-accent mt-2 block size-2 shrink-0"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )
        )
      }

      <div
        id="article"
        class="app-prose noise-article prose-headings:scroll-mt-28 mt-8 max-w-none"
      >
        <Content />
      </div>

      {
        updateNote && (
          <aside class="border-border bg-surface mt-8 border p-5">
            <p class="editorial-label">Update note</p>
            <p class="text-muted-foreground mt-2 leading-7">{updateNote}</p>
          </aside>
        )
      }
    </article>

    {
      relatedPosts.length > 0 && (
        <section class="border-border mx-auto mt-12 max-w-[980px] border-t pt-8">
          <p class="editorial-label">Related Stories</p>
          <ul class="mt-4 grid gap-4 md:grid-cols-3">
            {relatedPosts.map(post => (
              <Card {...post} compact />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</PostLayout>

<script is:inline>
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "fixed top-0 z-50 h-1 w-full bg-background/70";

    const progressBar = document.createElement("div");
    progressBar.className = "h-1 w-0 bg-accent";
    progressBar.id = "reading-progress";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }

  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled =
        height > 0 ? (document.documentElement.scrollTop / height) * 100 : 0;
      const bar = document.getElementById("reading-progress");
      if (bar) bar.style.width = `${scrolled}%`;
    });
  }

  createProgressBar();
  updateScrollProgress();
</script>
