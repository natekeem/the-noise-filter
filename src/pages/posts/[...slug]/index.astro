---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getCategory } from "@/data/categories";
import { toTransitionName } from "@/utils/toTransitionName";
import { getAssetPath } from "@/utils/withBase";
import { getReadingTime } from "@/utils/getReadingTime";
import { formatPostDate } from "@/utils/formatPostDate";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) =>
    import.meta.env.DEV ? true : !data.draft
  );
  const eligiblePosts = posts
    .filter(post => import.meta.env.DEV || !post.data.draft)
    .sort(
      (a, b) =>
        new Date(b.data.modDatetime ?? b.data.pubDatetime).getTime() -
        new Date(a.data.modDatetime ?? a.data.pubDatetime).getTime()
    );

  return eligiblePosts.map(post => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      relatedPosts: eligiblePosts
        .filter(
          item =>
            item.id !== post.id && item.data.category === post.data.category
        )
        .slice(0, 3),
    },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  relatedPosts: CollectionEntry<"posts">[];
};

const { post, relatedPosts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  ogImage: initOgImage,
  coverAlt,
  canonicalURL,
  pubDatetime,
  modDatetime,
  category,
  contentType,
  quickTake = [],
  quickFilter,
  updateNote,
  draft,
} = post.data;

const categoryInfo = getCategory(category);
const { Content } = await render(post);
const minutes = getReadingTime(post.body);
const date = formatPostDate(post.data);

let ogImageUrl = initOgImage;

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(
      ogImageUrl.startsWith("http") ? ogImageUrl : getAssetPath(ogImageUrl),
      Astro.url.origin
    ).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content" class="app-layout py-10 sm:py-14" data-pagefind-body>
    <article class="mx-auto max-w-[760px]" data-category={category}>
      <!-- Article Header -->
      <header class="border-border border-b pb-8">
        <div class="flex flex-wrap items-center gap-2">
          {
            categoryInfo && (
              <a
                href={`/the-noise-filter/categories/${categoryInfo.slug}`}
                class="category-label"
              >
                {categoryInfo.name}
              </a>
            )
          }
          <span class="text-muted-foreground text-xs" aria-hidden="true"
            >&bull;</span
          >
          <span class="editorial-label">{contentType}</span>
          {
            draft && (
              <>
                <span class="text-muted-foreground text-xs" aria-hidden="true">
                  &bull;
                </span>
                <span class="editorial-label text-amber-600 dark:text-amber-400">
                  Draft Preview
                </span>
              </>
            )
          }
        </div>

        <h1
          style={{ viewTransitionName: toTransitionName(title) }}
          class="font-display text-foreground mt-4 text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-5xl"
        >
          {title}
        </h1>
        <p
          class="text-muted-foreground mt-4 text-lg leading-relaxed sm:text-xl"
        >
          {description}
        </p>

        <!-- Meta Line -->
        <p class="post-meta mt-5 text-sm">
          <span class="text-foreground font-medium"
            >By {config.site.author}</span
          >
          <time datetime={date.iso}>{date.label}</time>
          <span>{minutes} min read</span>
          {date.isUpdated && <span class="text-xs italic">(Updated)</span>}
        </p>

        <!-- Cover Image -->
        {
          ogImageUrl && (
            <div class="media-frame mt-8 aspect-video w-full">
              <img
                src={getAssetPath(ogImageUrl)}
                alt={coverAlt ?? "Article cover image"}
                class="h-full w-full object-cover"
                width="1680"
                height="945"
                loading="eager"
              />
            </div>
          )
        }
      </header>

      <!-- Quick Filter Component -->
      {
        quickFilter ? (
          <aside
            class="quick-filter quick-filter--stack my-10"
            aria-label="Quick Filter summary"
          >
            <p class="editorial-label text-muted-foreground px-1">
              Quick Filter
            </p>
            <dl class="mt-2">
              <div>
                <dt>
                  <span class="qf-key qf-key--changed" />
                  What changed
                </dt>
                <dd>{quickFilter.changed}</dd>
              </div>
              <div>
                <dt>
                  <span class="qf-key qf-key--matters" />
                  What matters
                </dt>
                <dd>{quickFilter.matters}</dd>
              </div>
              <div>
                <dt>
                  <span class="qf-key qf-key--ignore" />
                  What to ignore for now
                </dt>
                <dd>{quickFilter.ignore}</dd>
              </div>
            </dl>
          </aside>
        ) : (
          quickTake.length > 0 && (
            <aside class="signal-panel my-10 p-6" aria-label="Quick take">
              <p class="editorial-label text-muted-foreground">Quick Take</p>
              <ul class="mt-4 space-y-2.5">
                {quickTake.map(item => (
                  <li class="text-foreground flex items-start gap-3 text-base">
                    <span
                      class="bg-accent mt-2 block size-1.5 shrink-0 rounded-full"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )
        )
      }

      <!-- Main Prose Body -->
      <div id="article" class="app-prose mt-8 max-w-none">
        <Content />
      </div>

      <!-- Update Note -->
      {
        updateNote && (
          <aside class="border-border bg-surface-tint mt-12 rounded-lg border p-5 text-sm">
            <p class="editorial-label text-muted-foreground">Update Note</p>
            <p class="text-body mt-2 leading-relaxed">{updateNote}</p>
          </aside>
        )
      }
    </article>

    <!-- Keep Reading / Related Stories -->
    {
      relatedPosts.length > 0 && (
        <section class="border-border mx-auto mt-16 max-w-[960px] border-t pt-10">
          <div class="mb-8 flex items-baseline justify-between">
            <h2 class="section-heading text-2xl">Related stories</h2>
            <a
              href={`/the-noise-filter/categories/${category}`}
              class="signal-link text-sm font-medium"
            >
              More in {categoryInfo?.name ?? "this topic"} &rarr;
            </a>
          </div>
          <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map(p => (
              <Card {...p} variant="h3" layout="tile" />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</PostLayout>

<script is:inline>
  function createProgressBar() {
    if (document.getElementById("reading-progress")) return;
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "fixed top-0 left-0 z-50 h-0.5 w-full bg-transparent";

    const progressBar = document.createElement("div");
    progressBar.className =
      "h-full w-0 bg-accent transition-all duration-75 ease-out";
    progressBar.id = "reading-progress";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }

  function updateScrollProgress() {
    const handleScroll = () => {
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled =
        height > 0 ? (document.documentElement.scrollTop / height) * 100 : 0;
      const bar = document.getElementById("reading-progress");
      if (bar) bar.style.width = `${scrolled}%`;
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  createProgressBar();
  updateScrollProgress();
  document.addEventListener("astro:after-swap", () => {
    createProgressBar();
  });
</script>
