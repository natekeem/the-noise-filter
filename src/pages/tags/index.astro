---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle="Tags"
    pageDesc="Secondary topic labels for approved stories."
    eyebrow="Reference"
  >
    {
      tags.length > 0 ? (
        <ul class="flex flex-wrap gap-4">
          {tags.map(({ tag, tagName }) => (
            <Tag {tag} {tagName} />
          ))}
        </ul>
      ) : (
        <div class="signal-panel p-6">
          <p class="text-muted-foreground leading-7">
            No public tags yet. Categories are the primary navigation for this
            site.
          </p>
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>
