---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { categories } from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
---

<Layout
  title={`Sections | ${config.site.title}`}
  description="The Noise Filter editorial sections."
>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <p class="editorial-label">Editorial Sections</p>
    <h1 class="font-display mt-3 text-5xl leading-tight font-bold">
      Browse by signal.
    </h1>
    <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
      Categories are the primary way The Noise Filter organizes stories. Tags
      stay secondary and practical.
    </p>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        categories.map(category => {
          const categoryPosts = posts
            .filter(post => post.data.category === category.slug)
            .slice(0, 2);
          return (
            <section class="signal-panel p-5 sm:p-6">
              <p class="editorial-label">
                {categoryPosts.length} public stories
              </p>
              <h2 class="font-display mt-2 text-3xl font-bold">
                {category.name}
              </h2>
              <p class="text-muted-foreground mt-3 leading-7">
                {category.description}
              </p>
              {categoryPosts.length > 0 ? (
                <ul class="mt-5 grid gap-4">
                  {categoryPosts.map(post => (
                    <Card {...post} compact />
                  ))}
                </ul>
              ) : (
                <p class="border-border text-muted-foreground mt-5 border-t pt-4 leading-7">
                  This section is intentionally empty until a draft clears
                  review.
                </p>
              )}
              <a
                class="signal-link mt-5 inline-flex text-sm font-semibold"
                href={getRelativeLocaleUrl(
                  locale,
                  `categories/${category.slug}`
                )}
              >
                Open {category.name}
              </a>
            </section>
          );
        })
      }
    </div>
  </main>
  <Footer />
</Layout>
