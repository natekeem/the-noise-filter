---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { categories, getCategory } from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("posts"));

  return categories.map(category => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts.filter(post => post.data.category === category.slug),
    },
  }));
}

type Props = {
  category: NonNullable<ReturnType<typeof getCategory>>;
  posts: CollectionEntry<"posts">[];
};

const { category, posts } = Astro.props;
const [leadPost, ...otherPosts] = posts;
---

<Layout
  title={`${category.name} | ${config.site.title}`}
  description={category.description}
>
  <Header />
  <main id="main-content" class="app-layout py-10">
    <p class="editorial-label">Section</p>
    <h1 class="font-display mt-3 text-5xl leading-tight font-bold">
      {category.name}
    </h1>
    <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
      {category.description}
    </p>

    <section class="mt-9">
      {
        leadPost ? (
          <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
            <ul>
              <Card {...leadPost} />
            </ul>
            <ul class="grid gap-4">
              {otherPosts.slice(0, 4).map(post => (
                <Card {...post} compact />
              ))}
            </ul>
          </div>
        ) : (
          <div class="signal-panel p-6 sm:p-8">
            <p class="editorial-label">No public stories yet</p>
            <h2 class="font-display mt-3 text-3xl font-bold">
              This section is ready before the newsroom voice is.
            </h2>
            <p class="text-muted-foreground mt-4 max-w-2xl leading-8">
              The MVP keeps draft work private. Stories appear here only after
              source checks and explicit human approval.
            </p>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
