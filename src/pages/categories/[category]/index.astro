---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { categories, getCategory } from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("posts"));

  return categories.map(category => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts.filter(post => post.data.category === category.slug),
    },
  }));
}

type Props = {
  category: NonNullable<ReturnType<typeof getCategory>>;
  posts: CollectionEntry<"posts">[];
};

const { category, posts } = Astro.props;
---

<Layout
  title={`${category.name} | ${config.site.title}`}
  description={category.description}
>
  <Header />
  <main
    id="main-content"
    class="app-layout py-10 sm:py-14"
    data-category={category.slug}
  >
    <header class="border-border border-b pb-8">
      <div class="flex items-center gap-2">
        <span class="category-dot"></span>
        <p class="category-label">{category.name}</p>
      </div>
      <h1
        class="font-display text-foreground mt-3 text-4xl font-bold tracking-tight sm:text-5xl"
      >
        {category.name}
      </h1>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-relaxed">
        {category.description}
      </p>
    </header>

    <section class="mt-8">
      {
        posts.length > 0 ? (
          <ul class="divide-border divide-y">
            {posts.map(post => (
              <Card {...post} layout="row" variant="h2" />
            ))}
          </ul>
        ) : (
          <div class="signal-panel p-8 text-center sm:p-12">
            <p class="editorial-label text-muted-foreground">
              No public stories yet
            </p>
            <h2 class="font-display text-foreground mt-3 text-2xl font-bold">
              This channel is quiet right now.
            </h2>
            <p class="text-muted-foreground mx-auto mt-3 max-w-lg text-base leading-relaxed">
              Stories only appear here once source checks and editorial
              verification are complete.
            </p>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
