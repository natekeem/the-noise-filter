---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { categories, getCategory } from "@/data/categories";
import { getAssetPath } from "@/utils/withBase";
import { getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/getReadingTime";
import { formatPostDate } from "@/utils/formatPostDate";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const [leadPost, ...restPosts] = posts;
const latestListPosts = restPosts.slice(0, 5);

const categoryCounts = categories.map(cat => ({
  ...cat,
  count: posts.filter(post => post.data.category === cat.slug).length,
}));

const leadCategoryInfo = leadPost ? getCategory(leadPost.data.category) : null;
const leadDate = leadPost ? formatPostDate(leadPost.data) : null;
const leadMinutes = leadPost ? getReadingTime(leadPost.body) : 0;
const leadPostUrl = leadPost
  ? getPostUrl(leadPost.id, leadPost.filePath, locale)
  : "";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout pb-16">
    <!-- Intro Band: Headline and Value Proposition -->
    <section class="border-border border-b py-10 sm:py-14">
      <div class="max-w-3xl">
        <p class="editorial-label text-accent font-semibold tracking-wider">
          Independent Explainer Journal
        </p>
        <h1
          class="font-display text-foreground mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          Hot stories, <span class="marker">filtered</span> for regular adults.
        </h1>
        <p
          class="text-muted-foreground mt-4 text-lg leading-relaxed sm:text-xl"
        >
          What changed, what matters, and what to ignore in technology, online
          security, consumer policies, and digital culture—without hype, jargon,
          or outrage.
        </p>
      </div>
    </section>

    <!-- Lead Story with Integrated Quick Filter Box -->
    {
      leadPost && (
        <section
          class="border-border border-b py-10 sm:py-14"
          data-category={leadPost.data.category}
        >
          <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            {leadPost.data.ogImage && (
              <a
                href={leadPostUrl}
                class="media-frame group block aspect-[16/10] overflow-hidden"
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={getAssetPath(leadPost.data.ogImage)}
                  alt={leadPost.data.coverAlt ?? ""}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-102"
                  loading="eager"
                />
              </a>
            )}
            <div class="flex flex-col justify-center">
              {leadCategoryInfo && (
                <a
                  href={getRelativeLocaleUrl(
                    locale,
                    `categories/${leadCategoryInfo.slug}`
                  )}
                  class="category-label"
                >
                  {leadCategoryInfo.name}
                </a>
              )}
              <a href={leadPostUrl} class="group mt-2.5 block">
                <h2 class="font-display text-foreground group-hover:text-accent text-2xl leading-tight font-bold transition-colors sm:text-3xl lg:text-4xl">
                  {leadPost.data.title}
                </h2>
              </a>
              <p class="text-muted-foreground mt-3 text-base leading-relaxed sm:text-lg">
                {leadPost.data.description}
              </p>
              <p class="post-meta mt-4 text-sm">
                <time datetime={leadDate?.iso}>{leadDate?.label}</time>
                <span>{leadMinutes} min read</span>
              </p>
            </div>
          </div>

          {/* Lead Story Quick Filter Strip */}
          {leadPost.data.quickFilter && (
            <aside
              class="quick-filter quick-filter--strip mt-8"
              aria-label="Quick Filter breakdown"
            >
              <dl>
                <div>
                  <dt>
                    <span class="qf-key qf-key--changed" />
                    <span>What changed</span>
                  </dt>
                  <dd>{leadPost.data.quickFilter.changed}</dd>
                </div>
                <div>
                  <dt>
                    <span class="qf-key qf-key--matters" />
                    <span>What matters</span>
                  </dt>
                  <dd>{leadPost.data.quickFilter.matters}</dd>
                </div>
                <div>
                  <dt>
                    <span class="qf-key qf-key--ignore" />
                    <span>What to ignore for now</span>
                  </dt>
                  <dd>{leadPost.data.quickFilter.ignore}</dd>
                </div>
              </dl>
            </aside>
          )}
        </section>
      )
    }

    <!-- Main Content Area: Latest List + Topics Sidebar -->
    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-14">
      <!-- Left: Latest Stories List -->
      <section aria-labelledby="latest-stories-heading">
        <div
          class="border-border mb-6 flex items-baseline justify-between border-b pb-3"
        >
          <h2 id="latest-stories-heading" class="section-heading">
            Latest stories
          </h2>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="signal-link inline-flex items-center gap-1 text-sm font-medium"
          >
            View all stories <IconArrowRight class="size-3.5" />
          </a>
        </div>

        <ul class="divide-border divide-y">
          {
            latestListPosts.map(post => (
              <Card {...post} variant="h3" layout="row" />
            ))
          }
        </ul>
      </section>

      <!-- Right: Sticky Sidebar (Topics + Standards Guide + About) -->
      <aside class="space-y-8">
        <!-- Topics Box -->
        <div class="signal-panel p-5 sm:p-6">
          <h3 class="font-display text-foreground text-xl font-bold">Topics</h3>
          <p class="text-muted-foreground mt-1 text-xs">
            Browse coverage by channel
          </p>
          <ul class="divide-border/60 mt-4 divide-y text-sm">
            {
              categoryCounts.map(cat => (
                <li
                  data-category={cat.slug}
                  class="flex items-center justify-between py-2.5 first:pt-0 last:pb-0"
                >
                  <a
                    href={getRelativeLocaleUrl(
                      locale,
                      `categories/${cat.slug}`
                    )}
                    class="group text-foreground hover:text-accent flex items-center gap-2.5 font-medium transition-colors"
                  >
                    <span class="category-dot" />
                    <span>{cat.name}</span>
                  </a>
                  <span class="text-muted-foreground text-xs font-semibold tabular-nums">
                    {cat.count}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- How We Filter Box (Sidebar Guide) -->
        <div class="signal-panel p-5 sm:p-6">
          <p class="editorial-label text-muted-foreground">
            The 3-Point Filter
          </p>
          <h3
            class="font-display text-foreground mt-1.5 text-base font-semibold"
          >
            How every story is vetted
          </h3>
          <ul class="mt-4 space-y-3.5 text-xs sm:text-sm">
            <li class="flex items-start gap-3">
              <span class="qf-key qf-key--changed mt-1 shrink-0"></span>
              <div>
                <strong class="text-foreground block font-semibold"
                  >What changed</strong
                >
                <span class="text-muted-foreground text-xs leading-relaxed"
                  >Official policy, verifiable code, or terms of service
                  updates.</span
                >
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="qf-key qf-key--matters mt-1 shrink-0"></span>
              <div>
                <strong class="text-foreground block font-semibold"
                  >What matters</strong
                >
                <span class="text-muted-foreground text-xs leading-relaxed"
                  >Direct, tangible consequences for your household, wallet, or
                  privacy.</span
                >
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="qf-key qf-key--ignore mt-1 shrink-0"></span>
              <div>
                <strong class="text-foreground block font-semibold"
                  >What to ignore</strong
                >
                <span class="text-muted-foreground text-xs leading-relaxed"
                  >Internet rumors, panic headlines, and unconfirmed
                  speculation.</span
                >
              </div>
            </li>
          </ul>
        </div>

        <!-- About Note -->
        <div
          class="border-border/80 bg-surface-tint rounded-xl border p-5 text-sm"
        >
          <p class="font-display text-foreground text-base font-semibold">
            About The Noise Filter
          </p>
          <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
            Independent, research-backed explainers built for regular readers
            who want plain answers without tech industry hype or outrage
            culture.
          </p>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class="signal-link text-accent mt-3 inline-block text-xs font-medium"
          >
            Read our editorial standards &rarr;
          </a>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    sessionStorage.setItem(
      "backUrl",
      import.meta.env.BASE_URL.replace(/\/?$/, "/")
    );
  });
</script>
