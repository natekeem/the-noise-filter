---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`Page not found | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout py-16">
    <div class="signal-panel max-w-2xl p-8 sm:p-10">
      <p class="editorial-label">404</p>
      <h1 class="font-display mt-3 text-5xl leading-tight font-bold">
        That signal is not here.
      </h1>
      <p class="text-muted-foreground mt-4 text-lg leading-8">
        The page may have moved, or it may be a draft that is not part of the
        public build.
      </p>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="border-border bg-surface hover:border-accent mt-6 inline-flex border px-4 py-3 text-sm font-semibold"
      >
        Return home
      </a>
    </div>
  </main>
  <Footer />
</Layout>
